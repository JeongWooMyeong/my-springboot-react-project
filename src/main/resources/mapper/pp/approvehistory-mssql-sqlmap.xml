<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.example.springbootproject.pms.pp.po.service.dao.ApprovalHistoryMapper">
    <insert id="insertHistory">

        INSERT INTO APPROVAL_HISTORY
        (
            ORDNO,
            BEFORE_STATE,
            AFTER_STATE,
            REG_DATE
        )
        VALUES
            (
                #{ordno},
                '10',
                #{afterState},
                GETDATE()
            )

    </insert>

</mapper>