<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.example.springbootproject.pms.pp.po.service.dao.Pppo1000Mapper">
    <insert id="insert" parameterType="com.example.springbootproject.pms.pp.po.dto.Pppo1000Dto">
        INSERT INTO pppo1000t (
            ordno,
            ordstate,
            rgdate,
            rgr,
            upddate,
            updpn,
            autoapvean,
            jijumcd,
            coid,
            ntnid,
            memo,
            ordnore
        )
        VALUES (
                   #{ordno},
                   #{ordstate},
                   #{rgdate},
                   #{rgr},
                   #{upddate},
                   #{updpn},
                   #{autoapvean},
                   #{jijumcd},
                   #{coid},
                   #{ntnid},
                   #{memo},
                   #{ordnore}
               )
    </insert>

</mapper>