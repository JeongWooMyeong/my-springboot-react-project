<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.example.springbootproject.pms.pp.po.service.dao.Pppo1100Mapper">
    <insert id="insert" parameterType="com.example.springbootproject.pms.pp.po.dto.Pppo1100Dto">
        INSERT INTO pppo1100t (
            ordno,
            templateid,
            data,
            seq
        )
        VALUES (
                   #{ordno},
                   #{templateid},
                   #{data},
                   #{seq}
               )
    </insert>

    <select id="findByOrdNo" resultType="pppo1100Dto">
        SELECT
            ordno,
            templateid,
            data
        FROM pppo1100t
        WHERE ordno = #{ordno}
    </select>

    <select id="findByOrdNoList" resultType="pppo1100Dto">
        SELECT
            ordno,
            templateid,
            data
        FROM pppo1100t
        WHERE ordno = #{ordno}
    </select>

</mapper>