<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springbootproject.pms.ext.service.dao.oracle.ProductMapper">

    <resultMap id="ProductResultMap" type="com.example.springbootproject.pms.ext.dto.Product">
        <id property="productId" column="PRODUCT_ID"/>
        <result property="productName" column="PRODUCT_NAME"/>
        <result property="price" column="PRICE"/>
        <result property="stock" column="STOCK"/>
    </resultMap>

    <select id="findAll" resultMap="ProductResultMap">
        SELECT PRODUCT_ID, PRODUCT_NAME, PRICE, STOCK
        FROM PRODUCT
    </select>

    <select id="findById" parameterType="long" resultMap="ProductResultMap">
        SELECT PRODUCT_ID, PRODUCT_NAME, PRICE, STOCK
        FROM PRODUCT
        WHERE PRODUCT_ID = #{productId}
    </select>

    <insert id="insert" parameterType="com.example.springbootproject.pms.ext.dto.Product">
        INSERT INTO PRODUCT (PRODUCT_ID, PRODUCT_NAME, PRICE, STOCK)
        VALUES (#{productId}, #{productName}, #{price}, #{stock})
    </insert>

    <update id="update" parameterType="com.example.springbootproject.pms.ext.dto.Product">
        UPDATE PRODUCT
        SET PRODUCT_NAME = #{productName},
            PRICE = #{price},
            STOCK = #{stock}
        WHERE PRODUCT_ID = #{productId}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM PRODUCT WHERE PRODUCT_ID = #{productId}
    </delete>

</mapper>
